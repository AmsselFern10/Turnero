# =============================================================================
# Turnero de Matriculas 2026 - Variables de Entorno (Plantilla de Referencia)
#
# INSTRUCCIONES RAPIDAS:
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
#
# Esta plantilla tiene valores funcionales listos para usar en desarrollo.
# Para produccion: cambia las contrasenas, secretos JWT y HOST_IP.
#
# NUNCA commitear el archivo .env real al repositorio.
# =============================================================================

# -----------------------------------------------------------------------------
# Entorno de Ejecucion
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# PostgreSQL (Base de Datos Primaria)
# -----------------------------------------------------------------------------
DB_NAME=turnero
DB_USER=postgres
DB_PASSWORD=turnero
DB_HOST=localhost
DB_PORT_EXPOSED=5432
DB_POOL_MAX=20
DB_CONTAINER_NAME=turnero-db
DATABASE_URL=postgresql://postgres:turnero@localhost:5432/turnero

# -----------------------------------------------------------------------------
# pgBouncer (Pool de Conexiones Transaccionales)
# -----------------------------------------------------------------------------
PGBOUNCER_PORT_EXPOSED=5433

# -----------------------------------------------------------------------------
# Redis (Cache en RAM y Pub/Sub para WebSockets)
# -----------------------------------------------------------------------------
REDIS_PASSWORD=turnero_redis
REDIS_HOST=localhost
REDIS_PORT_EXPOSED=6379
REDIS_URL=redis://:turnero_redis@localhost:6379

# -----------------------------------------------------------------------------
# Servidor HTTP y WebSocket (Fastify)
# -----------------------------------------------------------------------------
APP_PORT=3000
APP_PORT_EXPOSED=3000

# IP LAN del host real (obligatoria si el servidor corre en Docker o WSL2)
# Permite que tablets y celulares de la red local accedan al Kiosko.
# Ejemplo: HOST_IP=192.168.1.50
HOST_IP=

# Origenes CORS permitidos en produccion (separados por coma, dejar vacio en dev)
# Ejemplo: ALLOWED_ORIGINS=http://192.168.1.50:3000,http://turnero.local:3000
ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Seguridad, JWT y Tokens de Sesion
# Estos valores son funcionales para desarrollo.
# IMPORTANTE: Genera nuevos secretos para produccion con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# -----------------------------------------------------------------------------
JWT_SECRET=c5f782c9e782622b1029c2b4e87dcbb2a89c891636270e515d96f9c9687e148e6471c26b485d46538965f3775d1f89e223ebef11f81d191295b92e7d704ecb12
JWT_EXPIRES_IN=2h

REFRESH_SECRET=7f589c3620f5c1d3a5a782a9b34e2c91834e910fa95d6cb46f32148dc8f45a190ea48d8b6711593dfa91845bb3269a2185c7f8a9e22c976d8b021946fe753b89
REFRESH_EXPIRES_IN=7d

# Costo de hash bcrypt (minimo 12 en produccion, 10 acelera tests)
BCRYPT_COST=12

# Limite de intentos de login por minuto por IP antes de HTTP 429
RATE_LIMIT_LOGIN_MAX=10

# Nivel de logging de Pino: trace | debug | info | warn | error
LOG_LEVEL=info
