# =============================================================================
# Turnero de Matrículas 2026 — Variables de Entorno
#
# INSTRUCCIONES:
#   cp .env.example .env
#   Completar los valores marcados con <CAMBIAR>
#   NUNCA commitear el archivo .env al repositorio
# =============================================================================

# -----------------------------------------------------------------------------
# Entorno
# -----------------------------------------------------------------------------
NODE_ENV=development          # development | production

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
DB_NAME=turnero
DB_USER=turnero_app
DB_PASSWORD=<CAMBIAR_PASSWORD_SEGURO>
DB_PORT_EXPOSED=5432          # Puerto expuesto al host (solo para desarrollo)

# -----------------------------------------------------------------------------
# pgBouncer
# -----------------------------------------------------------------------------
PGBOUNCER_PORT_EXPOSED=5433   # Puerto del pool de conexiones

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_PASSWORD=<CAMBIAR_REDIS_PASSWORD>
REDIS_PORT_EXPOSED=6379       # Puerto expuesto al host (solo para desarrollo)

# -----------------------------------------------------------------------------
# Aplicación Node.js
# -----------------------------------------------------------------------------
APP_PORT=3000
APP_PORT_EXPOSED=3000

# JWT — Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<CAMBIAR_JWT_SECRET_64_CHARS_MINIMO>
JWT_EXPIRES_IN=2h

# Refresh token — diferente al JWT_SECRET
REFRESH_SECRET=<CAMBIAR_REFRESH_SECRET_64_CHARS_MINIMO>
REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Seguridad
# -----------------------------------------------------------------------------
BCRYPT_COST=12                # Mínimo 12. No reducir en producción.
LOG_LEVEL=info                # trace | debug | info | warn | error
